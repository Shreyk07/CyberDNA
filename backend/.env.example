# CyberDNA Backend Environment Configuration
PORT=3001
NODE_ENV=development

# Optional MongoDB Connection URI for analytical state persistence
# Defaults to local in-memory store initialized with Parquet/CSV dataset if not provided
MONGODB_URI=mongodb://localhost:27017/cyberdna

# Python Analytics Pipeline Path
PYTHON_PATH=python
PIPELINE_SCRIPT_PATH=../analytics/cyberdna_pipeline/cli.py

# Model Tuning Defaults
ISOLATION_FOREST_CONTAMINATION=0.15
Z_SCORE_ANOMALY_THRESHOLD=2.5
MINIMUM_BASELINE_EVENTS=10
